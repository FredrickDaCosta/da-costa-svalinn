rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read and write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // WebAuthn credentials
    match /webAuthnCredentials/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /credentials/{credentialId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // WebAuthn challenges - server only (no client access needed)
    match /webAuthnChallenges/{userId} {
      allow read, write: if false;
    }

    // Audit log - users can read their own logs, only server can write
    match /authAuditLog/{logId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    // AI Reports - users can create reports if authenticated
    match /aiReports/{reportId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // allScans — root-level scan collection for admin aggregation
    // Any authenticated user can write their own scans; reads are filtered client-side
    match /allScans/{scanId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // adminEvents — revenue / metrics tracking
    // Authenticated users can create events; reads filtered client-side to admin only
    match /adminEvents/{eventId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
