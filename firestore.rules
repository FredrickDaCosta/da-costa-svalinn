rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is admin
    // Matches the same admin allowlist used client-side in
    // src/app/dashboard/admin/page.tsx (ADMIN_UIDS / ADMIN_EMAILS).
    //
    // Passkey-authenticated admin sessions carry a custom uid ("Fredrick")
    // and NO email claim at all — the email-only check below always failed
    // for that login path, which is why the admin page rendered (client-side
    // isAdmin passed) but every Firestore read still came back "Missing or
    // insufficient permissions" (rules-side isAdmin failed). Both checks are
    // kept: magic-link admin sessions do carry a real email.
    //
    // Rules cannot read NEXT_PUBLIC_ADMIN_UID (it's a build-time env var, not
    // available here), so the uid is hardcoded. This isn't a new exposure:
    // the same value is already inlined into the public client bundle today
    // (verified directly in the deployed JS), so this file doesn't leak
    // anything an attacker couldn't already read from the site itself.
    function isAdmin() {
      return request.auth != null &&
        (request.auth.uid == "Fredrick" ||
         request.auth.token.email in ['fredrick.a.dacosta@gmail.com', 'fad@da-costa.online']);
    }

    // Users can read and write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // WebAuthn credentials
    match /webAuthnCredentials/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /credentials/{credentialId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // WebAuthn challenges - server only (no client access needed)
    match /webAuthnChallenges/{userId} {
      allow read, write: if false;
    }

    // Audit log - users can read their own logs, only server can write
    match /authAuditLog/{logId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    // AI Reports - users can create reports if authenticated
    match /aiReports/{reportId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // allScans — root-level scan collection for admin aggregation
    // Any authenticated user can write their own scans; reads restricted to admin
    match /allScans/{scanId} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // adminEvents — revenue / metrics tracking
    // Authenticated users can create events; reads restricted to admin
    match /adminEvents/{eventId} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // analystIncidents — root-level incidents for admin visibility
    // Authenticated users can create incidents; reads restricted to admin
    match /analystIncidents/{incidentId} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Threat Intelligence — root collection for shared IOCs
    // Authenticated users can read; writes via backend only
    match /threatIntel/{iocId} {
      allow read: if request.auth != null;
      allow write: if false; // Only backend workers write
    }

    // IOCs — root collection for deduplicated IOCs
    match /iocs/{iocId} {
      allow read: if request.auth != null;
      allow write: if false; // Only backend pipeline writes
    }

    // CVEs — root collection for vulnerability data
    match /cves/{cveId} {
      allow read: if request.auth != null;
      allow write: if false; // Only backend ingestion writes
    }

    // Playbooks — root collection for response playbooks
    match /playbooks/{playbookId} {
      allow read: if request.auth != null;
      allow write: if false; // Only admin/backend writes
    }

    // Cases — root collection for admin case management
    match /cases/{caseId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Organizations — multi-tenancy
    match /organizations/{orgId} {
      allow read: if request.auth != null && request.auth.token.orgId == orgId;
      allow write: if request.auth != null && request.auth.token.orgId == orgId && request.auth.token.role in ['owner', 'admin'];
    }

    // Feedback — learning loop data
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Rate limits — per-IP tracking
    match /rateLimits/{ip} {
      allow read, write: if true; // Allow anonymous for rate limiting
    }

    // Compliance reports
    match /complianceReports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Saved queries
    match /savedQueries/{queryId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Notification preferences
    match /notificationPrefs/{prefId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}