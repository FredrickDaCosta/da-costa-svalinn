{
  "hosting": {
    "public": "hosting-placeholder",
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "svalinn-ssr",
          "region": "europe-west1"
        }
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
